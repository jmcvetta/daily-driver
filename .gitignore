# OpenTofu / Terraform
#
# terraform.tfstate is tracked deliberately; the .backup beside it is
# rewritten on every apply and carries nothing the state does not.
.terraform/
*.tfstate.backup
*.log.txt

# `coder-eval` writes its runs -- transcripts, per-replicate scores, costs, the
# preserved sandboxes and the HTML report -- into `runs/` under the directory it
# was invoked from, which for `make evals-run` is `evals/`.
evals/runs/

# `coder_eval` reads a `.env` from the working directory with
# `load_dotenv(override=True)`, so it beats the shell environment --
# `ANTHROPIC_API_KEY` included. Never commit one.
.env

# Python
__pycache__/

# Dev dependencies the Makefile installs for the Python legs
# (requirements-dev.txt -- see the Makefile's .dev-deps bootstrap).
.dev-deps/
