{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject-constitution.py session-start",
            "timeout": 10,
            "statusMessage": "Loading the daily-driver constitution"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject-constitution.py subagent-start",
            "timeout": 10,
            "statusMessage": "Handing the subagent the constitution"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject-constitution.py pre-tool-use",
            "timeout": 10,
            "statusMessage": "Handing the subagent the constitution"
          }
        ]
      },
      {
        "matcher": "^(AskUserQuestion|request_user_input)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/ask-in-chat.py",
            "timeout": 10,
            "statusMessage": "Sending the question to the chat reply"
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(add_issue_comment|create_session)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/title-gate.py pre-tool-use",
            "timeout": 10,
            "statusMessage": "Checking the session is titled"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*__(set_session_title|get_session)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/title-gate.py post-tool-use",
            "timeout": 10,
            "statusMessage": "Recording the session title"
          }
        ]
      }
    ]
  }
}
