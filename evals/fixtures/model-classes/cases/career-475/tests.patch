+def test_git_sync_removes_merged_worktree_without_upstream(tmp_path: Path) -> None:
+    """A merged linked branch must not need tracking metadata for cleanup."""
+    primary, linked, remote = _sandbox(tmp_path)
+    _merge_stale_branch_without_upstream(primary, remote)
+
+    result = _run(primary, "make", "git_sync")
+
+    assert f"removed stale worktree: {linked}" in result.stdout
+    assert not linked.exists()
+    assert not _branch_exists(primary)
+
+
+def test_git_sync_keeps_merged_worktree_with_remote_branch(tmp_path: Path) -> None:
+    """A same-named remote branch must keep an untracked linked branch live."""
+    primary, linked, remote = _sandbox(tmp_path)
+    _merge_stale_branch_without_upstream(primary, remote)
+    stale_sha = _run(primary, "git", "rev-parse", STALE_BRANCH).stdout.strip()
+    _run(remote, "git", "update-ref", f"refs/heads/{STALE_BRANCH}", stale_sha)
+
+    result = _run(primary, "make", "git_sync")
+
+    assert "removed stale worktree:" not in result.stdout
+    assert linked.exists()
+    assert _branch_exists(primary)
+
