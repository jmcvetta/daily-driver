+def _warns_about_kept_worktree(stderr: str, linked: Path) -> bool:
+    """Whether one application warning on stderr names the kept branch and worktree.
+
+    The wording around the two names is the implementation's to choose; Git's
+    own refusal carries no ``WARN`` marker and does not count.
+    """
+    return any(
+        line.startswith("WARN")
+        and STALE_BRANCH in line.split()
+        and str(linked) in line
+        for line in stderr.splitlines()
+    )
+
