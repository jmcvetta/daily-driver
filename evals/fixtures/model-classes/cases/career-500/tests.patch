index 00000000..bfb1126f
--- /dev/null
+++ b/tests/test_release_lock.py
@@ -0,0 +1,301 @@
+"""What .github/scripts/regenerate-release-lock.sh actually does, against
+repositories built here.
+
+With separate-pull-requests the action returns the release PRs as an array
+(`steps.release-please.outputs.prs`), and the script checks out each branch and
+regenerates `kokoro/uv.lock` where the branch moved a member's version. The
+workflow wiring is pinned in test_infra_github.py; this runs the real script
+over a real repository and reads the lock commits back out of git, so the
+behaviour the workflow depends on is something a test can lose.
+
+The script's own failure mode is a spurious commit: `uv lock` is a no-op on a
+branch whose member versions did not move, so committing without the diff check
+would write a lock commit onto every non-Python release branch. The fake `uv`
+below reproduces the real one's one observable effect -- it rewrites
+`kokoro/uv.lock` from the member versions -- so the diff check, not the fake,
+is what each test asserts.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parent.parent
+SCRIPT = REPO / ".github" / "scripts" / "regenerate-release-lock.sh"
+
+MEMBERS = ("core", "pipeline", "viewer")
+
+FAKE_UV = """#!/usr/bin/env bash
+# Fake uv for tests: `uv lock --project kokoro` regenerates kokoro/uv.lock from
+# the member versions, the one observable effect the real `uv lock` has for the
+# script's diff check. Arguments beyond `lock` are ignored.
+[ "$1" = "lock" ] || { echo "fake uv: unexpected args: $*" >&2; exit 1; }
+{
+  for member in core pipeline viewer; do
+    version="$(sed -n 's/^version = "\\([^"]*\\)"/\\1/p' "kokoro/$member/pyproject.toml")"
+    printf 'kokoro-%s = %s\\n' "$member" "$version"
+  done
+} > kokoro/uv.lock
+"""
+
+
+def _lockfile(versions: dict[str, str]) -> str:
+    """_lockfile renders kokoro/uv.lock the way the fake uv writes it."""
+    return "".join(f"kokoro-{m} = {versions[m]}\n" for m in MEMBERS)
+
+
+def _git_env(tmp: Path) -> dict[str, str]:
+    """_git_env isolates a git subprocess from the developer's own config."""
+    return {
+        **os.environ,
+        "HOME": str(tmp),
+        "GIT_CONFIG_GLOBAL": os.devnull,
+        "GIT_CONFIG_SYSTEM": os.devnull,
+    }
+
+
+class Fixture:
+    """A git repository with a bare `origin` remote and a kokoro workspace,
+    standing in for this repository just after release-please has force-pushed
+    its release branches."""
+
+    def __init__(self, root: Path, remote: Path, tmp: Path) -> None:
+        self.root = root
+        self.remote = remote
+        self.tmp = tmp
+        root.mkdir(parents=True, exist_ok=True)
+        self.git("init", "-q", "-b", "master")
+        self.git("config", "user.email", "fixture@example.invalid")
+        self.git("config", "user.name", "Fixture")
+
+        for member in MEMBERS:
+            self.write(
+                f"kokoro/{member}/pyproject.toml",
+                '[project]\nname = "kokoro-%s"\nversion = "0.1.0"\n' % member,
+            )
+        self.write("kokoro/uv.lock", _lockfile({m: "0.1.0" for m in MEMBERS}))
+        self.git("add", "-A")
+        self.git("commit", "-q", "-m", "seed")
+
+    def git(self, *args: str) -> str:
+        """git runs a git command in the fixture and returns its stdout."""
+        return subprocess.run(
+            ["git", *args],
+            cwd=self.root,
+            check=True,
+            capture_output=True,
+            text=True,
+            env=_git_env(self.tmp),
+        ).stdout.strip()
+
+    def write(self, relative: str, text: str) -> None:
+        """write puts text at a path in the fixture, creating parents."""
+        path = self.root / relative
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+
+    def bump(self, member: str, version: str) -> None:
+        """bump moves a member's version, leaving kokoro/uv.lock stale."""
+        path = self.root / "kokoro" / member / "pyproject.toml"
+        path.write_text(
+            path.read_text().replace('version = "0.1.0"', f'version = "{version}"')
+        )
+
+    def release_branch(self, name: str) -> None:
+        """release_branch commits the working tree onto a branch and returns to
+        master, leaving the branch's lockfile as release-please left it."""
+        self.git("checkout", "-q", "-b", name)
+        self.git("add", "-A")
+        self.git("commit", "-q", "-m", "release " + name)
+        self.git("checkout", "-q", "master")
+
+    def seed_origin(self) -> None:
+        """seed_origin creates the bare origin, pushes every local branch, then
+        narrows the fetch refspec to master alone — the state actions/checkout's
+        `fetch-depth: 1` single-branch clone leaves the workflow in.
+
+        `git remote`, `git fetch` and `git push` are blocked for Python-side
+        subprocesses by the repo's network guard, which cannot tell a local
+        bare repository from a live remote. The script under test performs
+        those operations itself, against a filesystem path rather than a
+        network; running the seeding through bash keeps the guard's Python-side
+        interception out of the way without reaching a live site.
+
+        After the push, the release branches are on origin but not tracked
+        locally, and the fetch refspec maps master alone — so the script's own
+        fetch must create the `origin/<branch>` tracking ref, which a bare
+        branch-name fetch does not once the refspec is narrowed.
+        """
+        subprocess.run(
+            [
+                "bash",
+                "-c",
+                "set -euo pipefail;"
+                ' git init -q --bare "$1";'
+                ' git remote add origin "$1";'
+                " git push -q origin --all",
+                "_",
+                str(self.remote),
+            ],
+            cwd=self.root,
+            check=True,
+            capture_output=True,
+            text=True,
+            env=_git_env(self.tmp),
+        )
+        self.git(
+            "config",
+            "remote.origin.fetch",
+            "+refs/heads/master:refs/remotes/origin/master",
+        )
+        for ref in self.git(
+            "for-each-ref", "--format=%(refname)", "refs/remotes/origin"
+        ).splitlines():
+            if ref != "refs/remotes/origin/master":
+                self.git("update-ref", "-d", ref)
+
+    def run(self, prs: list[dict], fake_uv_bin: Path) -> subprocess.CompletedProcess:
+        """run invokes the script with PRS and the fake uv on PATH."""
+        return subprocess.run(
+            ["bash", str(SCRIPT)],
+            cwd=self.root,
+            capture_output=True,
+            text=True,
+            env={
+                **_git_env(self.tmp),
+                "PATH": f"{fake_uv_bin}{os.pathsep}{os.environ.get('PATH', '')}",
+                "PRS": json.dumps(prs),
+            },
+        )
+
+    def branch_lock(self, branch: str) -> str:
+        """branch_lock returns kokoro/uv.lock as committed on a remote branch."""
+        return subprocess.run(
+            ["git", "-C", str(self.remote), "show", f"{branch}:kokoro/uv.lock"],
+            check=True,
+            capture_output=True,
+            text=True,
+            env=_git_env(self.tmp),
+        ).stdout
+
+    def branch_subjects(self, branch: str) -> list[str]:
+        """branch_subjects returns commit subjects on a remote branch since
+        master, oldest first."""
+        return subprocess.run(
+            [
+                "git",
+                "-C",
+                str(self.remote),
+                "log",
+                "--format=%s",
+                f"master..{branch}",
+            ],
+            check=True,
+            capture_output=True,
+            text=True,
+            env=_git_env(self.tmp),
+        ).stdout.splitlines()
+
+
+@pytest.fixture
+def fake_uv(tmp_path: Path) -> Path:
+    """fake_uv installs the fake uv on a bin dir and returns it."""
+    bindir = tmp_path / "bin"
+    bindir.mkdir()
+    (bindir / "uv").write_text(FAKE_UV)
+    (bindir / "uv").chmod(0o755)
+    return bindir
+
+
+@pytest.fixture
+def fixture(tmp_path: Path) -> Fixture:
+    """fixture builds the repository the tests run the script against."""
+    return Fixture(tmp_path / "repo", tmp_path / "remote", tmp_path)
+
+
+def test_each_python_branch_gets_its_own_lock_update(
+    fixture: Fixture, fake_uv: Path
+) -> None:
+    """A release of core and pipeline regenerates each branch's lock alone.
+
+    The core branch carries only core's bump; the pipeline branch only
+    pipeline's. A non-Python branch carries no lock commit at all.
+    """
+    fixture.bump("core", "0.2.0")
+    fixture.release_branch("release-please--branches--master--components--kokoro-core")
+    fixture.bump("pipeline", "0.3.0")
+    fixture.release_branch(
+        "release-please--branches--master--components--kokoro-pipeline"
+    )
+    fixture.write("agent-cli/package.json", '{"version": "0.2.0"}\n')
+    fixture.release_branch("release-please--branches--master--components--agent-cli")
+    fixture.seed_origin()
+
+    proc = fixture.run(
+        [
+            {"headBranchName": "release-please--branches--master--components--kokoro-core"},
+            {"headBranchName": "release-please--branches--master--components--kokoro-pipeline"},
+            {"headBranchName": "release-please--branches--master--components--agent-cli"},
+        ],
+        fake_uv,
+    )
+    assert proc.returncode == 0, proc.stderr
+
+    core = fixture.branch_lock(
+        "release-please--branches--master--components--kokoro-core"
+    )
+    assert core == _lockfile({"core": "0.2.0", "pipeline": "0.1.0", "viewer": "0.1.0"})
+
+    pipeline = fixture.branch_lock(
+        "release-please--branches--master--components--kokoro-pipeline"
+    )
+    assert pipeline == _lockfile(
+        {"core": "0.1.0", "pipeline": "0.3.0", "viewer": "0.1.0"}
+    )
+
+    agent = fixture.branch_subjects(
+        "release-please--branches--master--components--agent-cli"
+    )
+    assert agent == ["release release-please--branches--master--components--agent-cli"]
+
+
+def test_a_python_branch_whose_lock_is_current_gets_no_commit(
+    fixture: Fixture, fake_uv: Path
+) -> None:
+    """A branch whose member version did not move gets no lock commit.
+
+    This is the `always-update` case: release-please force-pushes a branch even
+    when nothing changed, and the script must not write a spurious commit.
+    """
+    fixture.write("kokoro/viewer/CHANGELOG.md", "## 0.1.0\n")
+    fixture.release_branch(
+        "release-please--branches--master--components--kokoro-viewer"
+    )
