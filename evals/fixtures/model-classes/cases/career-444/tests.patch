+def test_names_match_registry() -> None:
+    """`stages.names`'s two tuples agree with `STAGE_REGISTRY`'s own columns.
+
+    `names.py` is a transcription of the registry's `name` and `cost`
+    columns; a stage added to the registry and not to `names.py` fails here.
+    """
+    assert tuple(spec.name for spec in STAGE_REGISTRY) == names.STAGE_NAMES
+    assert (
+        tuple(spec.name for spec in STAGE_REGISTRY if spec.cost != "mechanical")
+        == names.LLM_STAGES
+    )
