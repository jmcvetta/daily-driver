+def test_kokoro_venv_compiles_bytecode_on_sync() -> None:
+    """`setup-uv` caches uv's wheel store, not the venv, so every kokoro job
+    rebuilds the venv from scratch, and Prefect is compiled from source in
+    four processes per job -- the pytest controller at collection, the two
+    xdist workers, and the uvicorn subprocess each worker starts for
+    `prefect_test_harness` -- without this setting (issue #468). Compiling
+    once at sync time costs under 4s and saves roughly 12s off pytest
+    start-up and 4s off each server boot."""
+    config = tomllib.loads(KOKORO_PYPROJECT.read_text())
+    compile_bytecode = config.get("tool", {}).get("uv", {}).get("compile-bytecode")
+    assert compile_bytecode is True, (
+        "kokoro/pyproject.toml no longer sets tool.uv.compile-bytecode = true; "
+        "the venv CI rebuilds every run would go back to cold-importing "
+        "Prefect from source in four processes per job"
+    )
+
