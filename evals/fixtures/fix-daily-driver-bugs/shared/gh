#!/usr/bin/env python3
"""Record fixture-only gh reads and writes for local-skill evaluations."""
import json
import sys
from pathlib import Path

root = Path.cwd()
state_path = root / "fixture-state.json"
log_path = root / "issue-actions.jsonl"
args = sys.argv[1:]
# Global repository flags may precede or follow the subcommand, as in real gh.
cleaned = []
skip = False
for value in args:
    if skip:
        skip = False
    elif value in ("-R", "--repo"):
        skip = True
    elif value.startswith("--repo="):
        continue
    else:
        cleaned.append(value)
args = cleaned
if args == ["--version"]:
    print("gh version 2.94.0 (offline fixture)")
    sys.exit(0)
if args[:2] == ["auth", "status"]:
    print("offline fixture GitHub client: authenticated for recording only")
    sys.exit(0)
if args[:2] == ["repo", "view"]:
    print("jmcvetta/daily-driver")
    sys.exit(0)
state = json.loads(state_path.read_text(encoding="utf-8"))

def record(action, **details):
    with log_path.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps({"action": action, **details}, sort_keys=True) + "\n")

def issue(number):
    try:
        return state["issues"][str(number)]
    except KeyError:
        print(f"GraphQL: Could not resolve to an issue with the number of {number}.", file=sys.stderr)
        sys.exit(1)

def output(value):
    print(json.dumps(value))

if args[:2] == ["issue", "list"]:
    record("list", args=args[2:])
    output([{"number": int(number), "title": item["title"], "labels": [{"name": label} for label in item["labels"]]}
            for number, item in state["issues"].items() if item.get("state", "OPEN") == "OPEN"])
elif args[:2] == ["search", "issues"]:
    record("search", args=args[2:])
    output(state.get("search_results", []))
elif args[:2] == ["issue", "view"]:
    number = args[2]
    requested = args[args.index("--json") + 1].split(",") if "--json" in args else []
    item = issue(number)
    record("read", number=number, fields=requested)
    result = dict(item)
    result["number"] = int(number)
    result["labels"] = [{"name": label} for label in item["labels"]]
    result.setdefault("state", "OPEN")
    result.setdefault("comments", [])
    result.setdefault("blockedBy", {"nodes": []})
    result.setdefault("blocking", {"nodes": []})
    result.setdefault("parent", None)
    result.setdefault("closedByPullRequestsReferences", [])
    output({key: result[key] for key in requested if key in result})
elif args[:2] == ["issue", "edit"]:
    number = args[2]
    item = issue(number)
    record("edit", number=number, args=args[3:])
    # One `gh issue edit` is one request: an injected body failure rejects the
    # whole call, so no label or title change from it persists.
    i = 3
    while i < len(args):
        flag = args[i]
        value = args[i + 1] if i + 1 < len(args) else ""
        if flag == "--add-label":
            for label in filter(None, value.split(",")):
                if label not in item["labels"]:
                    item["labels"].append(label)
        elif flag == "--remove-label":
            gone = set(value.split(","))
            item["labels"] = [old for old in item["labels"] if old not in gone]
        elif flag in ("--title", "-t"):
            item["title"] = value
        elif flag in ("--body", "-b", "--body-file", "-F"):
            if number in state.get("fail_body_write", []):
                print("fixture: injected body write failure", file=sys.stderr)
                sys.exit(1)
            item["body"] = Path(value).read_text(encoding="utf-8") if flag in ("--body-file", "-F") else value
        else:
            i += 1
            continue
        i += 2
    state_path.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    print(f"fixture: updated issue {number}")
elif args[:2] == ["issue", "comment"]:
    number = args[2]
    for flag in ("-b", "--body"):
        if flag in args:
            body = args[args.index(flag) + 1]
            break
    else:
        body = None
    if body is not None:
        pass
    elif "--body-file" in args or "-F" in args:
        flag = "--body-file" if "--body-file" in args else "-F"
        body = Path(args[args.index(flag) + 1]).read_text(encoding="utf-8")
    else:
        body = ""
    issue(number).setdefault("comments", []).append({"body": body})
    record("comment", number=number, body=body)
    state_path.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    print(f"fixture: commented on issue {number}")
elif args[:2] == ["pr", "list"]:
    record("pr-list", args=args[2:])
    output(state.get("pull_requests", []))
elif args[:2] == ["pr", "view"]:
    number = args[2]
    record("pr-read", number=number, args=args[3:])
    output(state.get("pull_request_details", {}).get(number, {}))
else:
    record("unsupported", args=args)
    print(f"fixture: unsupported gh command: {' '.join(args)}", file=sys.stderr)
    sys.exit(2)
